"    choice\n"
"        prompt \"Escolher LIVRO\"\n"
"        default BOOK_LFS_ANY\n"
"        help\n"
"            Selecione se você quer construir o LFS ou instalar as\n"
"            ferramentas BLFS\n"

#. type: Plain text
#: Config.in:22
#, no-wrap
msgid ""
"        config    BOOK_LFS_ANY\n"
"            bool \"Linux From Scratch\"\n"
"            help\n"
"                Set up the tools to build LFS, and optionally run the build\n"
msgstr ""
"        config    BOOK_LFS_ANY\n"
"            bool \"Linux From Scratch\"\n"
"            help\n"
"                Configure as ferramentas para construir o LFS e,\n"
"                opcionalmente, execute a construção\n"

#. type: Plain text
#: Config.in:30
#, no-wrap
msgid ""
"        config    BOOK_BLFS\n"
"            bool \"Beyond Linux From Scratch (see help)\"\n"
"            help\n"
"                if the LFS system has already been built, and you have not\n"
"                installed the tools to build BLFS packages during that "
"build,\n"
"                install those tools now.\n"
"    endchoice\n"
msgstr ""
"        config    BOOK_BLFS\n"
"            bool \"Beyond Linux From Scratch (veja-se ajuda)\"\n"
"            help\n"
"                se o sistema LFS já tiver sido construído e você não\n"
"                tiver instalado as ferramentas para construir\n"
"                pacotes do BLFS durante essa construção, instale\n"
"                essas ferramentas agora.\n"
"    endchoice\n"

