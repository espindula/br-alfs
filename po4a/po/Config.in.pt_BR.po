#. type: Plain text
#: Config.in:98
#, no-wrap
msgid ""
"    config    COMMIT\n"
"        string    \"Which point in git history?\"\n"
"        default    \"trunk\" if LFS_MULTILIB_NO || BOOK_BLFS\n"
"        default    \"multilib\" if ! LFS_MULTILIB_NO\n"
"        depends on    BRANCH\n"
"        help\n"
"            You can select the development version of the book using "
"\"trunk\".\n"
"            A stable version may be selected with its version string, for\n"
"            example \"12.1\".\n"
"            Actually any way to denote a commit in git can be used, such as\n"
"            an abbreviated commit sha or a tag or a branch name.\n"
msgstr ""
"    config    COMMIT\n"
"        string    \"Qual ponto no histórico git?\"\n"
"        default    \"trunk\" if LFS_MULTILIB_NO || BOOK_BLFS\n"
"        default    \"multilib\" if ! LFS_MULTILIB_NO\n"
"        depends on    BRANCH\n"
"        help\n"
"            Você consegue selecionar a versão de desenvolvimento do livro\n"
"            usando \"trunk\". Uma versão estável pode ser selecionada com "
"a\n"
"            sequência de caracteres da versão dela, por exemplo \"12.1\". "
"Na\n"
"            verdade, qualquer maneira para denotar uma submissão no git "
"pode\n"
"            ser usada, tal como um resumo abreviado de submissão ou uma\n"
"            etiqueta ou um nome de ramificação.\n"

