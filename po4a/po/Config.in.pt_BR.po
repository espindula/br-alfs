"        config  TST_1\n"
"            bool    \"Only final system critical testsuites\"\n"
"            help\n"
"                #-- Critical tests:\n"
"                # Only Glibc, Binutils, GMP, MPFR, MPC and GCC\n"
"                # testsuites for final system. The others are commented\n"
"                # out.\n"
msgstr ""

#. type: Plain text
#: Config.in:573
#, no-wrap
msgid ""
"        config    TST_2\n"
"            bool    \"All final system testsuites\"\n"
"            help\n"
"                #-- All final system test suites:\n"
