#, no-wrap
msgid ""
"    #--- BOOK/script\n"
"    choice\n"
"        prompt \"Choose BOOK\"\n"
"        default BOOK_LFS_ANY\n"
"        help\n"
"            Select whether you want to build LFS or install the BLFS tools\n"
msgstr ""
