#. type: Plain text
#: Config.in:4
#, no-wrap
msgid ""
"# Check for \"nproc\" presence:\n"
"config HAVE_NPROC\n"
"    def_bool $(shell,if nproc >/dev/null 2>&1; then echo y; else echo n; "
"fi)\n"
msgstr ""
"# Verificar presença do \"nproc\":\n"
"config HAVE_NPROC\n"
"    def_bool $(shell,if nproc >/dev/null 2>&1; then echo y; else echo n; "
"fi)\n"

#. type: Plain text
#: Config.in:8
#, no-wrap
msgid ""
"# Check for \"cpuset controller in cgroup v2\" presence:\n"
"config HAVE_CGROUP\n"
"    def_bool $(shell,if grep -q cpuset /sys/fs/cgroup/cgroup.controllers "
"2>/dev/null; then echo y; else echo n; fi)\n"
msgstr ""
"# Verificar presença de \"controlador de conjunto de UCP no cgroup v2\":\n"
"config HAVE_CGROUP\n"
"    def_bool $(shell,if grep -q cpuset /sys/fs/cgroup/cgroup.controllers "
"2>/dev/null; then echo y; else echo n; fi)\n"

#. type: Plain text
