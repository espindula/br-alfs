#. type: Plain text
#: Config.in:79
#, no-wrap
msgid ""
"        config    BRANCH\n"
"            bool   \"retrieved from git repository\"\n"
"            help\n"
"                Use a book XML source downloaded from the git repository, "
"and\n"
"                checked out at any commit (branch/tag/sha)\n"
msgstr ""
"        config    BRANCH\n"
"            bool   \"recuperado a partir de repositório git\"\n"
"            help\n"
"                Use um fonte XML do livro transferido a partir do\n"
"                repositório git e retirado em qualquer submissão\n"
